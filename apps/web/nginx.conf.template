# Rendered by the nginx image's entrypoint; only the variables set in the environment
# are substituted, so nginx's own $variables stay.
server {
  listen 8080;
  root /usr/share/nginx/html;

  location /api/ {
    # The API name is looked up on each request (resolver plus a variable), so nginx
    # starts even when the API Service does not exist yet.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $api_upstream http://${API_HOST}:${API_PORT};
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    # Run events are server-sent events: pass bytes through as they come.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  location / {
    try_files $uri /index.html;
  }
}
