{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Email draft",
  "description": "The email contract: what the email writer returns.",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "preheader", "body", "call_to_action"],
  "properties": {
    "subject": { "type": "string", "minLength": 1, "maxLength": 150 },
    "preheader": { "type": "string", "maxLength": 200 },
    "body": { "type": "string", "minLength": 1 },
    "call_to_action": { "type": "string", "minLength": 1, "maxLength": 100 }
  }
}
